<mujoco model="camera_frame_lab">
  <statistic center="0.1 0 0.15" extent="1"/>
  <visual>
    <global azimuth="120" elevation="-25"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6"/>
  </visual>
  <asset>
    <texture name="floor_texture" type="2d" builtin="checker"
             rgb1="0.08 0.16 0.24" rgb2="0.18 0.30 0.42"
             width="512" height="512"/>
    <material name="floor_material" texture="floor_texture"
              texrepeat="8 8" texuniform="true" reflectance="0.15"/>
  </asset>
  <worldbody>
    <light pos="0 -1 2" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="floor_material"/>

    <!-- Built-in box: size contains half-lengths, so this cube is 0.08 m wide.
         No joint: keep the target fixed during coordinate-transform practice. -->
    <body name="cube" pos="0.1 0.05 0.04">
      <geom name="cube_geom" type="box" size="0.04 0.04 0.04"
            rgba="0.3 0.8 0.3 1"/>
      <site name="object_origin" size="0.003" rgba="1 0 0 0"/>
    </body>

    <!-- Camera +X right, +Y up, -Z forward; looks at the cube center. -->
    <camera name="lab_camera" mode="fixed" pos="0.1 -0.55 0.64"
            xyaxes="1 0 0 0 1 1" fovy="45"/>
  </worldbody>
</mujoco>
